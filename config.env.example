# Copy to ~/.config/share/config.env, fill in, then: chmod 600 ~/.config/share/config.env
# The CLI refuses to read this file if other users on the machine can.

SHARE_URL=https://share.example.com

# Cloudflare dashboard → any zone's Overview page, right column.
CLOUDFLARE_ACCOUNT_ID=

# Printed by `bunx wrangler d1 create share-db`.
SHARE_D1_DATABASE_ID=

# API token with exactly one permission: Account · D1 · Edit.
SHARE_D1_TOKEN=

# R2 → Manage API tokens → Object Read & Write, applied to this bucket only.
SHARE_R2_BUCKET=share-files
SHARE_R2_ACCESS_KEY_ID=
SHARE_R2_SECRET_ACCESS_KEY=
